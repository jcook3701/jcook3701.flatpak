{% macro deskflow_config() -%}
[General]
autoHide=false
closeToTray=true
configFile=/home/jcook/deskflow.conf
cryptoEnabled=true
elevateMode=false
elevateModeEnum=0
enableService=false
enableUpdateCheck=true
groupClientChecked=false
groupServerChecked=true
initiateConnectionFromServer=false
interface=
invertScrollDirection=false
languageSync=true
lastVersion=1.17.2.0
loadFromSystemScope=false
logFilename=/home/jcook/deskflow.log
logLevel2=0
logToFile=false
mainWindowPosition=@Point(1025 298)

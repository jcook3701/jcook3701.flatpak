{% macro deskflow_server_config() -%}
section: screens
end

section: aliases
end

section: links
end

section: options
	protocol = barrier
	relativeMouseMoves = false
	win32KeepForeground = false
	disableLockToScreen = false
	clipboardSharing = true
	clipboardSharingSize = 3072
	switchCorners = none
	switchCornerSize = 0
end
{%- endmacro %}

{{- deskflow_server_config() -}}
